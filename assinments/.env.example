# Server Port (default 5001 avoids macOS AirPlay port 5000 conflict)
PORT=5001

# MongoDB Connection String (Atlas or Local)
# Example local: mongodb://127.0.0.1:27017/hemant_portfolio
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.xyz.mongodb.net/hemant_portfolio?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/hemant_portfolio

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173

# Node Environment
NODE_ENV=development
